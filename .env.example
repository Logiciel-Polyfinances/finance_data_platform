# Copy this file to .env and fill in real values (local development).
#
# In AWS nothing here is set by hand: infra/lambda.tf sets the plain values
# (ENV, BUCKET_ID, DB_NULL_POOL, ...) and secrets arrive as
# `<NAME>_SSM_PARAM=/finance-data-platform/...` pointers that src/core/ssm.py
# resolves from SSM Parameter Store at cold start (DATABASE_URL -> Supabase
# transaction pooler, API_KEY, FRED_API_KEY, OPENFIGI_API_KEY).
# All variables here are read once at startup by src/core/config.py (Settings).
# Missing/invalid required variables fail fast with one clear error listing
# everything that's wrong, instead of a random crash deep inside whichever
# job happens to run first.

# local | docker | ci | prod -- branched on by src/api/deps.py::authenticate
# (only "local" is allowed to run without API_KEY set).
ENV=local

# --- Postgres (serving layer) -----------------------------------------------
# Must start with postgresql:// / postgresql+psycopg2:// / postgresql+psycopg://
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- S3 data lake (bronze/silver/gold) --------------------------------------
BUCKET_ID=your-s3-bucket-name

# AWS credentials for boto3 + polars S3 I/O. Either naming works (Settings
# accepts both); AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_DEFAULT_REGION
# are the boto3/AWS-standard names.
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
AWS_REGION=ca-central-1

# --- Vendor API keys ---------------------------------------------------------
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# https://www.openfigi.com/api -- optional, anonymous calls are rate-limited but work
OPENFIGI_API_KEY=

# --- API auth -----------------------------------------------------------------
# Env master key checked against the X-API-Key header (src/api/deps.py). It
# authenticates as admin (full read+write, no rate limit) and also gates the
# /admin key-management endpoints. Required whenever ENV != local -- the API
# fails closed (500) without it. Hand out per-app DB keys via POST /admin/api-keys
# rather than sharing this master key.
API_KEY=

# Per-key rate limits (fixed 1-minute window, enforced via Redis; admin/local
# exempt; no-op when REDIS_URL is unset -- i.e. always a no-op in AWS, where
# API Gateway throttling is the rate limit instead). rate_limit_per_minute caps every
# authenticated request; the write cap applies to ingestion triggers
# (register/refresh). Set to 0 to disable. Defaults shown.
# RATE_LIMIT_PER_MINUTE=120
# RATE_LIMIT_WRITE_PER_MINUTE=10

# Comma-separated allowed origins for CORS, e.g. https://app.example.com.
# "*" (default) allows any origin -- fine while no frontend exists yet.
CORS_ORIGINS=*

# --- Misc ---------------------------------------------------------------------
# Used to cache GET /prices, /fundamentals, /macro, /instruments/*/figi
# responses (src/core/cache.py). Fails open -- the API works fine, just
# uncached, if this is unset or unreachable. Local only: no Redis in AWS.
REDIS_URL=redis://localhost:6379/0

# --- On-demand backfills (optional) ------------------------------------------
# State machines POST /v1/instruments and .../refresh start a ticker's backfills
# on (set by infra/lambda.tf in AWS). Unset -> they run in-process instead.
# PRICES_STATE_MACHINE_ARN=
# FANOUT_STATE_MACHINE_ARN=
# SEC_FUNDAMENTALS_FUNCTION_ARN=

# --- DB connection pool (optional) -------------------------------------------
# SQLAlchemy pool sizing (src/core/database.py). Defaults shown; tune so
# (uvicorn workers x DB_POOL_SIZE) stays under the Postgres/pooler limit.
# DB_NULL_POOL=true disables client-side pooling (set in AWS Lambda, where
# Supabase's transaction pooler does the pooling).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

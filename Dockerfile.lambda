# AWS Lambda container image -- ONE image for every function (the API and all
# the ETL jobs). infra/lambda.tf picks the entry point per function through
# `image_config.command`; the CMD below is only the default (the API).
#
# Why an image and not a zip: the dependency closure (pyarrow + polars +
# pandas + numpy + yfinance/curl_cffi + matplotlib ...) is ~530 MB unzipped,
# over Lambda's 250 MB zip limit -- and the API itself imports most of it
# (ticker registration -> yfinance/polars, charts -> matplotlib), so there's no
# light "API-only" subset worth a separate zip either. Images go up to 10 GB.
#
# Build (CI does exactly this, see .github/workflows/deploy.yml):
#   docker build --platform linux/amd64 --provenance=false -f Dockerfile.lambda -t fdp-lambda .
# --provenance=false matters: Lambda rejects the multi-manifest index buildx
# produces when attestations are on.
#
# The local docker stack (docker-compose.local.yml) keeps using `dockerfile`
# (uvicorn), not this one.

# --- Stage 1: the internal React UI, served by FastAPI at /app ---------------
FROM node:20-slim AS frontend-build
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend ./
RUN npm run build

FROM public.ecr.aws/lambda/python:3.12

COPY --from=ghcr.io/astral-sh/uv:0.10.9 /uv /bin/uv

# Lambda's filesystem is read-only except /tmp: point every library that
# wants a writable cache/config dir there (matplotlib's font cache,
# yfinance's tz/cookie cache via platformdirs' XDG_CACHE_HOME).
ENV MPLCONFIGDIR=/tmp/matplotlib \
    XDG_CACHE_HOME=/tmp/.cache \
    PYTHONUNBUFFERED=1

# Dependencies first (cached layer, only rebuilt when the lock changes), from
# the locked versions only: --frozen fails if uv.lock is out of sync with
# pyproject.toml, --no-dev drops pytest/ruff. Bytecode is precompiled to cut
# cold-start time (the task root is read-only at runtime).
COPY pyproject.toml uv.lock ./
RUN uv export --frozen --no-dev --no-hashes --no-emit-project --no-header -o /tmp/requirements.txt \
 && uv pip install --no-cache --compile-bytecode \
      --python /var/lang/bin/python3.12 \
      --target "${LAMBDA_TASK_ROOT}" \
      -r /tmp/requirements.txt \
 && rm /tmp/requirements.txt

COPY src ${LAMBDA_TASK_ROOT}/src
COPY --from=frontend-build /app/frontend/dist ${LAMBDA_TASK_ROOT}/frontend/dist
RUN /var/lang/bin/python3.12 -m compileall -q ${LAMBDA_TASK_ROOT}/src

CMD ["src.main.handler"]
